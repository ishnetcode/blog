---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Load all posts, skip drafts, and sort newest first.
const posts = (await getCollection('blog', (post) => !post.data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Ish Rastogi">
	<h1>Hello, I'm Ish</h1>
	<p>
		I'm a software engineer who builds .NET systems and AI agents by day, and
		cooks and wanders at the weekend. This is my corner of the internet for
		writing about both.
	</p>

	<p>Expect posts on:</p>
	<ul class="topics">
		<li><strong>AI and .NET</strong>: building agents and making them work in production</li>
		<li><strong>Cloud and architecture</strong>: lessons from real systems at scale</li>
		<li><strong>Life outside code</strong>: food, places and whatever I'm curious about</li>
	</ul>

	<p><a href="/about">More about me →</a></p>

  <h2>Posts</h2>

  {posts.length === 0 && <p>First post coming soon.</p>}

  <ul class="posts">
    {posts.map((post) => (
      <li>
        <a href={`/blog/${post.id}`}>{post.data.title}</a>
        <p>
          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString('en-GB', {
              day: 'numeric',
              month: 'short',
              year: 'numeric',
            })}
          </time>
        </p>
        <p>{post.data.description}</p>
      </li>
    ))}
  </ul>
</BaseLayout>
