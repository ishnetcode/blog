---
import '../styles/global.css';
const { title, description = 'Code, curries and the occasional wrong turn.' } = Astro.props;
---

<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="alternate" type="application/rss+xml" title="Ish Rastogi" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <header>
        <a href="/">Ish Rastogi</a>
        <nav>
            <a href="/">Home</a>
            <a href="/about">About</a>
            <a href="/rss.xml">RSS</a>
        </nav>
    </header>

    <main>
      <slot />  <!-- page content goes here, like @RenderBody() -->
    </main>

    <footer>
      <p>© {new Date().getFullYear()}, Ish Rastogi, <a href="https://github.com/ishnetcode">GitHub</a> and <a href="https://www.linkedin.com/in/ish-rastogi-5b322010">LinkedIn</a></p>
    </footer>
  </body>
</html>
