    </header>

    <main>
      <slot />  <!-- page content goes here, like @RenderBody() -->
    </main>

    <footer>
      <p>© 2026, Ish Rastogi, <a href="https://github.com/ishnetcode">GitHub</a> and <a href="https://github.com/ishnetcode">LinkedIn</a></p>
    </footer>
  </body>
</html>
